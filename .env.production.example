# Copier en .env.production et remplir. Ne jamais committer le fichier rempli.

# Domaine pointant vers le serveur (enregistrement DNS A/AAAA déjà créé)
DOMAIN=app.mondomaine.fr

# Base de données (générer : openssl rand -base64 24)
POSTGRES_USER=nextia
POSTGRES_PASSWORD=
POSTGRES_DB=nextia

# Signature des sessions (générer : openssl rand -base64 48)
AUTH_SECRET=

# Mentions vendeur sur les factures
COMPANY_NAME=Nextia
COMPANY_ADDRESS=
COMPANY_SIRET=
COMPANY_VAT=

# Paiement en ligne (optionnel — sans clé, la facturation reste manuelle)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
